# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Deployment Settings (Optional for Webhooks)
WEBHOOK_URL=https://your-domain.vercel.app/api/webhook
PORT=8000

# AI Insight Summary (Optional — leave blank to skip AI summaries)
OPENAI_API_KEY=

# Session Persistence (SQLite — datasets survive bot restarts locally)
DATABASE_PATH=bot_sessions.db

# Vercel Blob (persistent sessions on serverless deployments — optional)
# Create a Blob store in the Vercel dashboard and set its read/write token.
# When set, the bot uses Blob for sessions; otherwise it uses SQLite.
BLOB_READ_WRITE_TOKEN=

# Webhook secret (optional — webhook hardening)
# Telegram sends this value as the `X-Telegram-Bot-Api-Secret-Token` header on
# every update, and the bot rejects requests without a matching value.
# After changing it, re-visit https://<your-app>.vercel.app/api/set_webhook.
# The bot self-heals: a detected mismatch triggers an automatic webhook
# re-registration, so a forgotten re-visit can't lock the bot out.
TELEGRAM_WEBHOOK_SECRET=
